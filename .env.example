# ── PASTE THE BACKEND LINK HERE WHEN IT IS READY ──────────────────────────
# Example: https://settle-api.azurewebsites.net
# Leave EMPTY in production when the API serves this site from the same origin.
VITE_API_BASE_URL=__PASTE_API_URL_HERE__

# true  = use the in-browser mock API (MSW). false = call the real API.
VITE_USE_MOCKS=true

VITE_APP_NAME=TaskFlow

# Fallbacks used only when the user has no saved preference and the browser gives nothing
VITE_DEFAULT_CURRENCY=NGN

# single = one currency for the whole app (current backend decision: Nigeria / NGN only).
# multi  = per-invoice currency, selector and currency switchers appear (needs backend support).
VITE_CURRENCY_MODE=single
